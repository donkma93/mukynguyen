<?xml version="1.0" encoding="utf-8"?>
<!--
Hướng dẫn:
BatTat: Bật tắt Relife ( để 1 = Bật )
TaiSinh: Bật kiểm tra Relife
ThoiGian: Chống DoubleClick nhanh. Thời gian tính bằng giây
GioiHan: Đặt giới hạn mốc Relife
ChonLaiNv: Bật tắt chế độ chọn lại nv sau khi Relife ( An toàn nên bật 1 )
LevelReq: Yêu cầu cấp độ nhân vật. Max 400
AfterRelifeLevel: Cấp độ trả về sau khi Relife.
AfterRelifeReset: Reset trả về sau khi relife
DieuKienResets: Yêu cầu bao nhiêu Reset để được Relife
DiemTaiSinh: Số điểm dư sau khi Reset
DieuKienNgoc: nguyên liệu ngọc. sẽ khấu trừ trực tiếp vào bank!
-->
<TaiSinh>
	<Enabled>
		<Config BatTat = "1" TaiSinh ="1" ThoiGian="3" ChonLaiNv="1" GioiHan="10"/>
	</Enabled>
	
	<DieuKienLevel>
